# Server-only settings for the Next.js app. Copy to .env.local and fill in.
# Never prefix these with NEXT_PUBLIC_: the browser must not see these keys.

# FastAPI base URL, without /api/v1 and without a trailing slash
COMPLIANCEIQ_API_URL=http://127.0.0.1:8000

# One of the backend's API_KEYS
COMPLIANCEIQ_API_KEY=change-me-client-key

# Optional admin console (/admin): document uploads, re-indexing, jobs, usage stats.
# Enabled only when both are set. COMPLIANCEIQ_ADMIN_KEY must equal the backend's ADMIN_API_KEY.
COMPLIANCEIQ_ADMIN_KEY=
ADMIN_PASSWORD=
# Optional: signing secret for admin sessions (defaults to one derived from the two values above)
ADMIN_SESSION_SECRET=
