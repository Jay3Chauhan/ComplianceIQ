# ComplianceIQ configuration. Copy to .env and fill in the secrets.
# Every key maps to a field in config.py; anything omitted uses the default shown.

# ── LLM (Groq — https://console.groq.com) ─────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Query rewriting + claim verification (non-reasoning, fast)
GROQ_FAST_MODEL=qwen/qwen3.8-27b
# Tried in order on rate limits / unavailable models. Free-tier limits are per model.
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Visible answer budget; reasoning models (gpt-oss) get LLM_REASONING_ALLOWANCE extra
LLM_MAX_TOKENS=1400
LLM_REASONING_EFFORT=low
LLM_REASONING_ALLOWANCE=1000

# ── Vector store (Qdrant Cloud — https://cloud.qdrant.io) ─────────────────────
QDRANT_URL=https://YOUR-CLUSTER-ID.us-central1-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=regulations_v2

# ── Embeddings / rerank ───────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
ENABLE_RERANK=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_STRATEGY=hybrid
MAX_RETRIEVAL_CHUNKS=6
# Grounding gate (reranker probability). Re-calibrate if you change RERANKER_MODEL.
RERANK_MIN_SCORE=0.2
MAX_CONTEXT_CHARS=7000

# ── Chunking (changing these requires re-ingestion) ───────────────────────────
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# ── Anti-hallucination ────────────────────────────────────────────────────────
ENABLE_VERIFICATION=true
ENABLE_LLM_VERIFIER=true
ENABLE_ANSWER_REPAIR=true

# ── Persistence ───────────────────────────────────────────────────────────────
# SQLite by default; for Postgres: postgresql://user:pass@host:5432/db (pip install "psycopg[binary]")
DATABASE_URL=sqlite:///./data/complianceiq.db

# ── Security ──────────────────────────────────────────────────────────────────
# Comma-separated keys accepted in the X-API-Key header (required in production)
API_KEYS=change-me-client-key
# X-Admin-Key for /api/v1/admin/* (upload, reindex, delete)
ADMIN_API_KEY=change-me-admin-key
CORS_ORIGINS=*
RATE_LIMIT_PER_MINUTE=30
MAX_UPLOAD_MB=50

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Streamlit UI (set in the Streamlit environment, not the API) ──────────────
# COMPLIANCEIQ_API_URL=https://your-api.onrender.com/api
# COMPLIANCEIQ_API_KEY=change-me-client-key
