# Groq — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Qdrant Cloud — https://cloud.qdrant.io
QDRANT_URL=https://YOUR-CLUSTER-ID.us-central1-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=regulations

# Embeddings / rerank
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
ENABLE_RERANK=true
RERANKER_MODEL=BAAI/bge-reranker-base
RETRIEVAL_CANDIDATE_MULTIPLIER=4

# RAG tuning
MAX_RETRIEVAL_CHUNKS=6
CHUNK_SIZE=900
CHUNK_OVERLAP=120
SCORE_THRESHOLD=0.42
SCORE_FALLBACK_THRESHOLD=0.30
GROUNDED_MIN_SCORE=0.58

# Security / deploy
ADMIN_API_KEY=change-me-in-production
CORS_ORIGINS=*
APP_ENV=development
LOG_LEVEL=INFO

# Frontend (Streamlit Cloud secret / env)
# COMPLIANCEIQ_API_URL=https://your-api.onrender.com/api
